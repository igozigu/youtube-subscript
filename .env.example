# YouTube 대본 추출기 환경변수 설정

# 자막 언어 우선순위 (쉼표 구분)
DEFAULT_LANGUAGES=ko,en

# 영상 간 요청 딜레이 (밀리초)
FETCH_DELAY_MS=1500

# 최대 동시 처리 영상 수
MAX_CONCURRENT=3

# 쿠키 파일 경로 (YouTube 인증 우회용, 선택사항)
# COOKIE_FILE_PATH=/data/cookies.txt

# 출력 디렉터리
OUTPUT_DIR=./data/output

# 백엔드 포트
BACKEND_PORT=8000

# 프론트엔드 포트
FRONTEND_PORT=3000
